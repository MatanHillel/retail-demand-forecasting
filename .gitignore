# --- raw data is NEVER committed (PRD §42) ---------------------------------
data/raw/*
!data/raw/.gitkeep

# --- logs ------------------------------------------------------------------
logs/*
!logs/.gitkeep

# --- staging area for pipeline runs (promoted on success only, PRD §39) ----
artifacts/_staging/

# NOTE: data/processed/, artifacts/ and config/ are intentionally NOT ignored.

# --- python ----------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- local CI output (make ci-local / scripts/ci_local.sh, US-35) ------------
# Each job writes into its own --out-root here so the working tree's artifacts/
# and data/processed/ are never touched.
.ci-local/
.ci-local-stderr.txt
ci_out*/
ci_stderr.txt

# --- secrets ---------------------------------------------------------------
.env
.env.local

# --- editors / OS ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
